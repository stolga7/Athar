# Godot 4+ project cache. Regenerated on import; never commit.
.godot/

# Android build template, generated by the editor via
# Project > Install Android Build Template. It is large and reproducible,
# so it stays untracked — but it MUST be installed locally before any
# Android export (`--install-android-build-template`).
/android/

# Export output
/build/
/dist/
*.apk
*.aab
*.pck

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.swp
