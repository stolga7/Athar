root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Godot source and text resources use tabs (engine default)
[*.gd]
indent_style = tab
indent_size = 4

[*.{tscn,tres,godot,cfg,import,shader}]
indent_style = tab
indent_size = 4

# Documentation and config stay space-indented; keep hard line breaks in Markdown
[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
